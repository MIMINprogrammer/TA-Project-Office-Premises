# Environment variables for Pepper Labs Tenancy Clause Review System
# Copy this file to .env and fill in your values.

# Prisma database URL.
# Production / hosted (Supabase Postgres example):
#   - Get the connection string from your Supabase project: Settings → Database → Connection string.
#   - URL-encode any special characters in the password (e.g. "!" -> "%21").
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Local development fallback (SQLite dummy DB):
# DATABASE_URL="file:./db/custom.db"
