# Environment variables for Pepper Labs Tenancy Clause Review System
# Copy this file to .env and fill in your values.

# Supabase connection pooler (PgBouncer / transaction mode, port 6543).
# Used by the running application (Next.js / Prisma Client).
# Replace YOUR_PROJECT_REF, password, and region (ap-southeast-1) with your
# project's values from Supabase Dashboard → Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct (session mode, port 5432) — used by Prisma migrations (db:push / db:migrate).
# Same host as DATABASE_URL but port 5432 and WITHOUT the pgbouncer query params.
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Local development fallback (SQLite — no pooler needed):
# DATABASE_URL="file:./db/custom.db"
# (leave DIRECT_URL unset or commented out for SQLite)
